#!/usr/bin/env bash
# overseer-parent — launch the FLEET PARENT: a Claude session that operates your
# child workers for you. Talk to it ("start the Helix tests", "check on note",
# "OK"); it spawns/sends/reads children via the overseer CLI and reports back.
#
# This is the "operate" cockpit in its minimal form (no GUI yet) — you converse
# with one AI instead of babysitting many terminals. The GUI (a window with the
# chat + switchable child views) wraps THIS later.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
PARENT_MD="$HERE/parent/PARENT.md"
CLAUDE="${OVERSEER_CLAUDE:-$HOME/.claude/tools/claude-retry-wrapper.sh}"

[ -f "$PARENT_MD" ] || { echo "missing $PARENT_MD" >&2; exit 1; }
[ -x "$CLAUDE" ] || CLAUDE="$(command -v claude)"

echo "overseer-parent: starting the fleet parent. Talk to it in plain language." >&2
echo "  e.g.  「Helix のテスト直して始めて」「note 見て」「OK、次いって」" >&2
echo "  it operates children via ~/overseer/bin/overseer (never your own sessions)." >&2
echo >&2

# command-bridge: the guard hook (via --settings) blocks any Bash that isn't an
# `overseer ...` call, so the parent can't bypass the driver guards with raw tmux/rm.
# The tracked settings file is a template — it names the guard hook by absolute path, and an
# absolute path cannot be committed. Resolve it against this checkout, and FAIL CLOSED: the old
# form was `[ -f "$SANDBOX" ] && SETTINGS_ARG=(--settings ...)`, which silently launched Claude
# with --dangerously-skip-permissions and no hook whenever the file was present but unusable.
TMPL="$HERE/parent/sandbox-settings.json"
GUARD="$HERE/hooks/parent-bash-guard.py"
[ -f "$TMPL" ]  || { echo "parent sandbox template missing: $TMPL — refusing to launch unguarded" >&2; exit 1; }
[ -f "$GUARD" ] || { echo "parent Bash guard missing: $GUARD — refusing to launch unguarded" >&2; exit 1; }
mkdir -p "$HERE/data"
SANDBOX="$HERE/data/sandbox-resolved.json"
sed "s|__OVERSEER_HOME__|$HERE|g" "$TMPL" > "$SANDBOX"
grep -q '__OVERSEER_HOME__' "$SANDBOX" && { echo "sandbox substitution failed — refusing to launch unguarded" >&2; exit 1; }
exec "$CLAUDE" --dangerously-skip-permissions --settings "$SANDBOX" --append-system-prompt-file "$PARENT_MD" "$@"
